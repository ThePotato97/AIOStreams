+            level254: MISSING_U32,
+            ..Default::default()
+        };
+        if !present {
+            return dm;
+        }
+        dm.flags = DM_FLAG_PRESENT;
+        let blocks = [&color.cmv29_metadata, &color.cmv40_metadata]
+            .into_iter()
+            .flatten()
