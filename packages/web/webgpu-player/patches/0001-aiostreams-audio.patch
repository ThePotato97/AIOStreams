+/** Packets read for one that names its stream: TrueHD repeats a major sync at least every 128 access units. */
+const ATMOS_SEARCH_PACKETS = 160;
+const ATMOS_READERS: Readonly<Record<string, { profile: string, read: (packet: Uint8Array) => boolean | null }>> = {
+    eac3: { profile: EAC3_ATMOS_PROFILE, read: readEAC3Atmos },
+    truehd: { profile: TRUEHD_ATMOS_PROFILE, read: readTrueHDAtmos }
+};
+
+/** Names a TrueHD or E-AC-3 track Atmos as FFmpeg would, from the first of its packets that says (AtmosDetection.ts). */
+async function readAtmosProfile(track: InputAudioTrack, codec: string | null): Promise<string | null> {
+    const atmos = codec ? ATMOS_READERS[codec] : undefined;
+    if (!atmos) {
+        return null;
+    }
+    const reader = new PacketReader(track);
+    let packet = await reader.getFirst();
+    for (let read = 0; packet && read < ATMOS_SEARCH_PACKETS; read += 1) {
+        const found = atmos.read(packet.data);
+        if (found !== null) {
+            return found ? atmos.profile : null;
+        }
+        packet = await reader.getNext(packet);
+    }
+    return null;
+}
