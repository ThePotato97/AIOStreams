diff --git a/src/demux/dolby-vision/DolbyVisionDisplayManagement.ts b/src/demux/dolby-vision/DolbyVisionDisplayManagement.ts
new file mode 100644
index 0000000..13fa095
--- /dev/null
+++ b/src/demux/dolby-vision/DolbyVisionDisplayManagement.ts
@@ -0,0 +1,104 @@
+import { DOLBY_VISION_RPU_MAPPING_BYTE_LENGTH, DOLBY_VISION_RPU_SCHEMA_BYTE_LENGTH } from './DolbyVisionRPUParser';
+
+/** CIE xy of a display's primaries and white. */
+export type DolbyVisionPrimaries = Readonly<{
+    red: readonly [number, number]
+    green: readonly [number, number]
+    blue: readonly [number, number]
+    white: readonly [number, number]
+}>;
+
+/**
+ * A frame's Dolby Vision display-management levels as the RPU codes them (12-bit codes; 2048 is a neutral trim), in coded
+ * order: the first 8 L2, 5 L8 and 4 L10, and the last of each single level. Custom primaries are signed Q15 CIE xy.
+ */
+export type DolbyVisionDisplayManagement = Readonly<{
+    sourceMinPQ: number
+    sourceMaxPQ: number
+    level1: Readonly<{ min: number, avg: number, max: number }> | null
+    level2: readonly Readonly<{
+        targetMaxPQ: number, slope: number, offset: number, power: number, chromaWeight: number, saturationGain: number
+    }>[]
+    /** 2048 is no offset */
+    level3: Readonly<{ min: number, avg: number, max: number }> | null
+    level5: Readonly<{ left: number, right: number, top: number, bottom: number }> | null
+    level8: readonly Readonly<{
+        targetIndex: number, slope: number, offset: number, power: number, chromaWeight: number, saturationGain: number,
+        midContrast: number, clipTrim: number
+    }>[]
+    /** The index; at 19 and above, the custom primaries */
+    level9: Readonly<{ index: number, primaries: DolbyVisionPrimaries }> | null
+    level10: readonly Readonly<{
+        targetIndex: number, primaryIndex: number, targetMaxPQ: number, targetMinPQ: number, primaries: DolbyVisionPrimaries
+    }>[]
+    /** dm_version_index; null without an L254 */
+    level254: number | null
+}>;
+
+const FLAG_PRESENT = 1 << 0;
+const FLAG_LEVEL1 = 1 << 1;
+const FLAG_LEVEL3 = 1 << 2;
+const FLAG_LEVEL5 = 1 << 3;
+const FLAG_LEVEL9 = 1 << 4;
+const FLAG_LEVEL254 = 1 << 5;
+const MAXIMUM_L2 = 8;
+const MAXIMUM_L8 = 5;
+const MAXIMUM_L10 = 4;
+
+/** Returns a parser snapshot's display-management levels, or null when its RPU carries no display metadata. */
+export function readDolbyVisionDisplayManagement(packedData: ArrayBuffer): DolbyVisionDisplayManagement | null {
+    if (packedData.byteLength !== DOLBY_VISION_RPU_SCHEMA_BYTE_LENGTH) {
+        throw new RangeError(`packedData: ${packedData.byteLength} bytes, expected ${DOLBY_VISION_RPU_SCHEMA_BYTE_LENGTH}`);
+    }
+    const view = new DataView(packedData, DOLBY_VISION_RPU_MAPPING_BYTE_LENGTH);
+    let word = 0;
+    const next = (): number => view.getUint32(4 * word++, true);
+    const flags = next();
+    if (!(flags & FLAG_PRESENT)) {
+        return null;
+    }
+    const q15 = (): number => ((next() << 16) >> 16) / 32_768;
+    const primaries = (): DolbyVisionPrimaries => ({
+        red: [ q15(), q15() ], green: [ q15(), q15() ], blue: [ q15(), q15() ], white: [ q15(), q15() ]
+    });
+    const sourceMinPQ = next();
+    const sourceMaxPQ = next();
+    const l1 = { min: next(), avg: next(), max: next() };
+    const l2Count = next();
+    const level2 = [];
+    for (let i = 0; i < MAXIMUM_L2; i++) {
+        const entry = { targetMaxPQ: next(), slope: next(), offset: next(), power: next(), chromaWeight: next(), saturationGain: next() };
+        if (i < l2Count) level2.push(entry);
+    }
+    const l3 = { min: next(), avg: next(), max: next() };
+    const l5 = { left: next(), right: next(), top: next(), bottom: next() };
+    const l8Count = next();
+    const level8 = [];
+    for (let i = 0; i < MAXIMUM_L8; i++) {
+        const entry = {
+            targetIndex: next(), slope: next(), offset: next(), power: next(), chromaWeight: next(), saturationGain: next(),
+            midContrast: next(), clipTrim: next()
+        };
+        if (i < l8Count) level8.push(entry);
+    }
+    const l9 = { index: next(), primaries: primaries() };
+    const l10Count = next();
+    const level10 = [];
+    for (let i = 0; i < MAXIMUM_L10; i++) {
+        const entry = { targetIndex: next(), primaryIndex: next(), targetMaxPQ: next(), targetMinPQ: next(), primaries: primaries() };
+        if (i < l10Count) level10.push(entry);
+    }
+    const l254 = next();
+    return {
+        sourceMinPQ,
+        sourceMaxPQ,
+        level1: flags & FLAG_LEVEL1 ? l1 : null,
+        level2,
+        level3: flags & FLAG_LEVEL3 ? l3 : null,
+        level5: flags & FLAG_LEVEL5 ? l5 : null,
+        level8,
+        level9: flags & FLAG_LEVEL9 ? l9 : null,
+        level10,
+        level254: flags & FLAG_LEVEL254 ? l254 : null
+    };
+}
