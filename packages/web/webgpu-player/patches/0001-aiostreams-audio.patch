diff --git a/test/decode/audio/SelfLimitedPackage.test.ts b/test/decode/audio/SelfLimitedPackage.test.ts
new file mode 100644
index 0000000..70dcc3b
--- /dev/null
+++ b/test/decode/audio/SelfLimitedPackage.test.ts
@@ -0,0 +1,88 @@
+// A package that limits its own render: its blocks pass the output stage as rendered, peaks above the engine's ceiling kept.
+import { describe, expect, it } from 'vitest';
+
+import { CUSTOM_STEREO_CHANNEL_LAYOUT } from 'webgpu-player/audio/processing/CustomAudioChannelLayout';
+import DecodedAudioOutputStage from 'webgpu-player/audio/processing/DecodedAudioOutputStage';
+import { CUSTOM_AUDIO_LIMITER_CEILING_GAIN } from 'webgpu-player/audio/processing/StreamingAudioLookaheadLimiter';
+import type { StreamingAudioResamplerOutput } from 'webgpu-player/audio/processing/StreamingAudioOutputPipeline';
+import { createPackageAudioOutput, needsEngineLimiter } from 'webgpu-player/decode/audio/PackageSoftwareAudioDecoder';
+import { requireMicroseconds } from 'webgpu-player/TimeMath';
+
+const RATE = 48_000;
+const STEREO_MASK = 0x3;
+const FRAMES = 9_600;
+// A render that reaches 0.99 (about -0.09 dBFS), past the engine's -1 dBFS ceiling
+const PEAK = 0.99;
+
+const render = (): Float32Array[] => [ 0, 1 ].map((channel: number): Float32Array => Float32Array.from(
+    { length: FRAMES },
+    (_: unknown, i: number): number => PEAK * Math.sin((2 * Math.PI * 440 * i) / RATE + channel)
+));
+
+function block(attributes: Record<string, number>) {
+    return createPackageAudioOutput({
+        attributes: new Map(Object.entries(attributes)),
+        channelData: render(),
+        channelMask: STEREO_MASK,
+        frameCount: FRAMES,
+        sampleRate: RATE,
+        timestampMicroseconds: 1_000_000
+    }, requireMicroseconds(1_000_000), 0, 'test package');
+}
+
+/** The block through an output stage bound as the audio decode worker binds it, and the stage's samples. */
+function throughOutputStage(output: ReturnType<typeof block>): Float32Array[] {
+    const stage = new DecodedAudioOutputStage({
+        maximumOutputFrameCount: 1_920,
+        minimumOutputFrameCount: 1,
+        outputLayout: 'stereo',
+        routeCodec: 'truehd',
+        timestampToleranceMicroseconds: 1_000
+    });
+    const binding = stage.bind({
+        channelCount: 2,
+        layout: CUSTOM_STEREO_CHANNEL_LAYOUT,
+        rendered: needsEngineLimiter(output),
+        sampleRate: RATE
+    }, null);
+    const outputs: StreamingAudioResamplerOutput[] = [
+        ...binding.outputs,
+        ...binding.pipeline.push({ channelData: output.channelData.map((c: Float32Array): Float32Array => c.slice()), mediaTimeMicroseconds: output.mediaTimeMicroseconds }),
+        ...stage.finalize()
+    ];
+    return [ 0, 1 ].map((channel: number): Float32Array => {
+        const joined = new Float32Array(outputs.reduce((sum, o) => sum + o.frameCount, 0));
+        let at = 0;
+        for (const o of outputs) {
+            joined.set(o.channelData[channel]!.subarray(0, o.frameCount), at);
+            at += o.frameCount;
+        }
+        return joined;
+    });
+}
+
+const peak = (channels: Float32Array[]): number => Math.max(...channels.map((c: Float32Array): number => Math.max(...c.map(Math.abs))));
+
+describe('a package that limits its own render', () => {
+    it('reports it per block, with `limited` 1', () => {
+        expect(block({ limited: 1, objectCount: 15 }).limited).toBe(true);
+        expect(block({ objectCount: 15 }).limited).toBe(false);
+        expect(needsEngineLimiter(block({ limited: 1, objectCount: 15 }))).toBe(false);
+        expect(needsEngineLimiter(block({ objectCount: 15 }))).toBe(true);
+        // A stock decode never needs it, limited or not
+        expect(needsEngineLimiter(block({ objectCount: 0 }))).toBe(false);
+    });
+    it('comes out of the output stage sample for sample, peaks above the ceiling included', () => {
+        const input = render();
+        const output = throughOutputStage(block({ limited: 1, objectCount: 15 }));
+        expect(output[0]!.length).toBe(FRAMES);
+        expect(peak(output)).toBeGreaterThan(CUSTOM_AUDIO_LIMITER_CEILING_GAIN);
+        for (let channel = 0; channel < 2; channel += 1) {
+            expect(Array.from(output[channel]!)).toEqual(Array.from(input[channel]!));
+        }
+    });
+    it('while an object render it didn\'t limit is still limited to the ceiling', () => {
+        const output = throughOutputStage(block({ objectCount: 15 }));
+        expect(peak(output)).toBeLessThanOrEqual(CUSTOM_AUDIO_LIMITER_CEILING_GAIN + 1e-6);
+    });
+});
diff --git a/test/embed/AtmosDetection.test.ts b/test/embed/AtmosDetection.test.ts
new file mode 100644
index 0000000..2c6a84e
--- /dev/null
+++ b/test/embed/AtmosDetection.test.ts
@@ -0,0 +1,56 @@
+// Atmos named from a stream's own packets, against real streams' first frames and FFmpeg's names for them.
+import { describe, expect, it } from 'vitest';
+
+import { readEAC3Atmos, readTrueHDAtmos } from 'webgpu-player/embed/AtmosDetection';
+
+const hex = (value: string): Uint8Array => Uint8Array.from(value.match(/../gu)!.map((byte: string): number => parseInt(byte, 16)));
+
+// First bytes of streams FFmpeg names "Dolby Digital Plus + Dolby Atmos" (JOC, 5.1 core)
+const EAC3_ATMOS = [
+    '0b7705ff3f86ff7a4b408d2080880050001880080031000af3eec30c30c175dc7ea6baaacfdf425685f534b49f56acfa13ead006a26911cd54375fb857375cdb',
+    '0b7702ff3f86a03e49008e20808620d40200000040000000fe18404fb512524232546c7070612621242a40c0c0c0d05040505c7afd2b9acedf3a9caa1aa7cf95'
+];
+// ... and of E-AC-3 streams without Atmos: 5.1 and stereo
+const EAC3_PLAIN = [
+    '0b77037f3f87c000200000000200000004281fcc04010040100418f9f3e7cf9f3e7cf9f3e7dff3abe7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f',
+    '0b77067f3f87c00000000000400000004ec61861860e9a9d7a84696ab6f9f3e7ead242af461c1aefa1434b5d53f4e82ba6835dfa64cf9f427d3abce4cf9ebf85',
+    '0b7701ff3487c000208401004300cc041f804577d0e9bfb870dfbe7d0df3e7d5df3e7c7fceaf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3e7cf9f3'
+];
+const AC3 = '0b7778421e40ebf8403eff99c3c87313';
+// TrueHD access units with a major sync: 7.1 with the Atmos presentation, and 5.1 without
+const TRUEHD_ATMOS = '628b4fadf8726fba0017804fb7521000000087ef43fc0039';
+const TRUEHD_PLAIN = '9111ffd8f8726fba0007800fb752000000008c7f203c0000';
+
+describe('E-AC-3 Atmos, as FFmpeg reads it', () => {
+    it('finds flag_ec3_extension_type_a in JOC streams', () => {
+        for (const frame of EAC3_ATMOS) {
+            expect(readEAC3Atmos(hex(frame))).toBe(true);
+        }
+    });
+    it('finds none in streams without objects', () => {
+        for (const frame of EAC3_PLAIN) {
+            expect(readEAC3Atmos(hex(frame))).toBe(false);
+        }
+    });
+    it('reads nothing from AC-3, other substreams, or a header that ends early', () => {
+        expect(readEAC3Atmos(hex(AC3))).toBeNull();
+        const otherSubstream = hex(EAC3_ATMOS[0]!);
+        otherSubstream[2] |= 0x08;
+        expect(readEAC3Atmos(otherSubstream)).toBeNull();
+        expect(readEAC3Atmos(hex(EAC3_ATMOS[0]!).subarray(0, 8))).toBeNull();
+        expect(readEAC3Atmos(hex('00112233'))).toBeNull();
+    });
+});
+
+describe('TrueHD Atmos, as FFmpeg reads it', () => {
+    it('finds the fourth substream with the 16-channel presentation', () => {
+        expect(readTrueHDAtmos(hex(TRUEHD_ATMOS))).toBe(true);
+    });
+    it('finds none in a stream without it', () => {
+        expect(readTrueHDAtmos(hex(TRUEHD_PLAIN))).toBe(false);
+    });
+    it('reads nothing from an access unit without a major sync', () => {
+        expect(readTrueHDAtmos(hex('628b4fad00112233445566778899aabbccddeeff00112233'))).toBeNull();
+        expect(readTrueHDAtmos(hex('628b4fadf8726fba'))).toBeNull();
+    });
+});
