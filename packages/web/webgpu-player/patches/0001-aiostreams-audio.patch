+            ExtMetadataBlock::Level5(ExtMetadataBlockLevel5 {
+                active_area_left_offset: 0, active_area_right_offset: 0,
+                active_area_top_offset: 138, active_area_bottom_offset: 138,
+            }),
+            ExtMetadataBlock::Level8(ExtMetadataBlockLevel8 {
+                length: 10, target_display_index: 1, trim_slope: 1_900, ..Default::default()
+            }),
+            ExtMetadataBlock::Level9(ExtMetadataBlockLevel9 { length: 1, source_primary_index: 2, ..Default::default() }),
+            ExtMetadataBlock::Level10(ExtMetadataBlockLevel10 {
+                length: 5, target_display_index: 40, target_max_pq: 3_079, target_min_pq: 62,
+                target_primary_index: 0, ..Default::default()
+            }),
+            ExtMetadataBlock::Level254(ExtMetadataBlockLevel254 { dm_mode: 0, dm_version_index: 2 }),
+        ];
+        for block in blocks {
+            color.add_metadata_block(block).unwrap();
+        }
+        let mut context = ParserContext::default();
+        let output = parse_into(&mut context, &encode(&rpu)).unwrap();
+        let dm = |word: usize| header_word(&output[MAPPING_BYTE_LENGTH..], word);
+        assert_eq!(dm(0), DM_FLAG_PRESENT | DM_FLAG_LEVEL1 | DM_FLAG_LEVEL3 | DM_FLAG_LEVEL5 | DM_FLAG_LEVEL9 | DM_FLAG_LEVEL254);
+        assert_eq!([dm(3), dm(4), dm(5)], [7, 1_247, 2_081]);
