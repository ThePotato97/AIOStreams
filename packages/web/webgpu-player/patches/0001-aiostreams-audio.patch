+        }
+        let blocks = [
+            ExtMetadataBlock::Level1(ExtMetadataBlockLevel1::new(7, 2_081, 1_247)),
+            ExtMetadataBlock::Level2(ExtMetadataBlockLevel2 {
+                target_max_pq: 2_081, trim_slope: 2_100, trim_offset: 2_000, trim_power: 2_200,
+                trim_chroma_weight: 2_048, trim_saturation_gain: 2_300, ms_weight: 2_048,
