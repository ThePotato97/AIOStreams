+/// CM v2.9 then CM v4.0 sections: the first 8 L2, 5 L8 and 4 L10, and the last of each single level
+#[derive(Default)]
+struct PackedDisplayManagement {
+    flags: u32,
+    source_pq: [u32; 2],
+    level1: [u32; 3],
+    level2: Vec<[u32; 6]>,
+    level3: [u32; 3],
+    level5: [u32; 4],
+    level8: Vec<[u32; 8]>,
