+export const DOLBY_VISION_RPU_SCHEMA_BYTE_LENGTH = DOLBY_VISION_RPU_MAPPING_BYTE_LENGTH + DOLBY_VISION_RPU_DISPLAY_MANAGEMENT_BYTE_LENGTH;
 export const DOLBY_VISION_RPU_PARSER_REVISION_PREFIX = 0x38AD_EC04;
 export const DOLBY_VISION_RPU_SCHEMA_MAGIC = 0x5052_5644;
 export const MAXIMUM_DOLBY_VISION_RPU_PARSER_INPUT_BYTE_LENGTH = 64 * 1_024;
diff --git a/src/embed/AtmosDetection.ts b/src/embed/AtmosDetection.ts
new file mode 100644
index 0000000..875d4d9
--- /dev/null
+++ b/src/embed/AtmosDetection.ts
@@ -0,0 +1,219 @@
+// Dolby Atmos found in a stream's own packets, for a host that has no server-side probe to name it.
+// The eligibility reads Atmos from a MediaStream's Profile as FFmpeg names it, so this names it the
+// same way, from the same bits FFmpeg reads: TrueHD's major sync (libavcodec/mlpdec.c) and E-AC-3's
+// additional bitstream info (libavcodec/ac3_parser.c, `eac3_extension_type_a`).
+
+export const TRUEHD_ATMOS_PROFILE = 'Dolby TrueHD + Dolby Atmos';
+export const EAC3_ATMOS_PROFILE = 'Dolby Digital Plus + Dolby Atmos';
+
+const TRUEHD_MAJOR_SYNC = 0xF8726FBA;
+/** A TrueHD access unit's own header precedes its major sync */
+const TRUEHD_ACCESS_UNIT_HEADER_BYTES = 4;
+const TRUEHD_SUBSTREAMS_OFFSET = TRUEHD_ACCESS_UNIT_HEADER_BYTES + 16;
+const TRUEHD_SUBSTREAM_INFO_OFFSET = TRUEHD_ACCESS_UNIT_HEADER_BYTES + 17;
+const TRUEHD_ATMOS_SUBSTREAMS = 4;
+
+/**
+ * Reports whether a TrueHD access unit's major sync carries the 16-channel presentation (Atmos), as FFmpeg does: a fourth
+ * substream with the top bit of substream_info set. Null when the access unit has no major sync.
+ */
+export function readTrueHDAtmos(accessUnit: Uint8Array): boolean | null {
+    if (accessUnit.length <= TRUEHD_SUBSTREAM_INFO_OFFSET) {
+        return null;
+    }
+    const view = new DataView(accessUnit.buffer, accessUnit.byteOffset, accessUnit.byteLength);
+    if (view.getUint32(TRUEHD_ACCESS_UNIT_HEADER_BYTES) !== TRUEHD_MAJOR_SYNC) {
+        return null;
+    }
+    return (accessUnit[TRUEHD_SUBSTREAMS_OFFSET]! >> 4) === TRUEHD_ATMOS_SUBSTREAMS
+        && (accessUnit[TRUEHD_SUBSTREAM_INFO_OFFSET]! >> 7) === 1;
+}
+
+/** Reads big-endian bits, as FFmpeg's GetBitContext does; reads past the end throw. */
+class BitReader {
+    private position = 0;
+
+    constructor(private readonly bytes: Uint8Array) {}
+
+    read(count: number): number {
+        if (this.position + count > this.bytes.length * 8) {
+            throw new RangeError('past the end of the header');
+        }
+        let value = 0;
+        for (let i = 0; i < count; i += 1) {
+            value = value * 2 + ((this.bytes[this.position >> 3]! >> (7 - (this.position & 7))) & 1);
+            this.position += 1;
+        }
+        return value;
+    }
+
+    skip(count: number): void {
+        this.position += count;
+    }
+
+    /** Skips `count` bits where the flag before them is set. */
+    skipIf(count: number): void {
+        if (this.read(1)) {
+            this.skip(count);
+        }
+    }
+}
+
+const EAC3_SYNC_WORD = 0x0B77;
+const EAC3_MIN_BSID = 11;
+const EAC3_MAX_BSID = 16;
+const EAC3_FRAME_TYPE_INDEPENDENT = 0;
+const EAC3_FRAME_TYPE_DEPENDENT = 1;
+const EAC3_FRAME_TYPE_AC3_CONVERT = 2;
+const EAC3_FRAME_TYPE_RESERVED = 3;
+const EAC3_REDUCED_RATE_CODE = 3;
+const EAC3_BLOCKS = [ 1, 2, 3, 6 ];
+const CHANNEL_MODE_STEREO = 2;
+const CHANNEL_MODE_2F2R = 6;
+const MIX_DATA_5 = 1;
+const MIX_DATA_12 = 2;
+const MIX_DATA_SIZED = 3;
+
+type EAC3Header = {
+    blocks: number
+    channelMode: number
+    frameType: number
+    lfe: boolean
+    programs: number
+    rateCode: number
+};
+
+/** The frame's header up to its mixing metadata, or null where FFmpeg would read no Atmos flag from it. */
+function readHeaderStart(bits: BitReader, frame: Uint8Array): EAC3Header | null {
+    if (bits.read(16) !== EAC3_SYNC_WORD) {
+        return null;
+    }
+    const bsid = ((frame[5] ?? 0) >> 3) & 0x1F;
+    if (bsid < EAC3_MIN_BSID || bsid > EAC3_MAX_BSID) {
+        return null;
+    }
+    const frameType = bits.read(2);
+    const substream = bits.read(3);
+    if (frameType === EAC3_FRAME_TYPE_RESERVED || substream !== 0) {
+        return null;
+    }
+    bits.skip(11); // frame size
+    const rateCode = bits.read(2);
+    let blocks = 6;
+    if (rateCode === EAC3_REDUCED_RATE_CODE) {
+        bits.skip(2); // the reduced sample rate's code
+    } else {
+        blocks = EAC3_BLOCKS[bits.read(2)]!;
+    }
+    const channelMode = bits.read(3);
+    const lfe = bits.read(1) === 1;
+    bits.skip(5); // bitstream id
+    const programs = channelMode === 0 ? 2 : 1;
+    for (let i = 0; i < programs; i += 1) {
+        bits.skip(5); // dialogue normalization
+        bits.skipIf(8); // heavy compression
+    }
+    if (frameType === EAC3_FRAME_TYPE_DEPENDENT) {
+        bits.skipIf(16); // channel map
+    }
+    return { blocks, channelMode, frameType, lfe, programs, rateCode };
+}
+
+/** The mixing information an independent frame carries for other streams. */
+function skipStreamMixing(bits: BitReader, header: EAC3Header): void {
+    for (let i = 0; i < header.programs; i += 1) {
+        bits.skipIf(6); // program scale factor
+    }
+    bits.skipIf(6); // external program scale factor
+    const mixData = bits.read(2);
+    if (mixData === MIX_DATA_5) {
+        bits.skip(5);
+    } else if (mixData === MIX_DATA_12) {
+        bits.skip(12);
+    } else if (mixData === MIX_DATA_SIZED) {
+        bits.skip((bits.read(5) + 2) * 8);
+    }
+    if (header.channelMode < CHANNEL_MODE_STEREO) {
+        for (let i = 0; i < header.programs; i += 1) {
+            bits.skipIf(14); // pan information
+        }
+    }
+    if (bits.read(1)) {
+        for (let i = 0; i < header.blocks; i += 1) {
+            if (header.blocks === 1 || bits.read(1)) {
+                bits.skip(5); // block mixing configuration
+            }
+        }
+    }
+}
+
+function skipMixingMetadata(bits: BitReader, header: EAC3Header): void {
+    if (!bits.read(1)) {
+        return;
+    }
+    if (header.channelMode > CHANNEL_MODE_STEREO) {
+        bits.skip(2);
+        if (header.channelMode & 1) {
+            bits.skip(6);
+        }
+        if (header.channelMode & 4) {
+            bits.skip(6);
+        }
+    }
+    if (header.lfe) {
+        bits.skipIf(5);
+    }
+    if (header.frameType === EAC3_FRAME_TYPE_INDEPENDENT) {
+        skipStreamMixing(bits, header);
+    }
+}
+
+function skipInformationalMetadata(bits: BitReader, header: EAC3Header): void {
+    if (!bits.read(1)) {
+        return;
+    }
+    bits.skip(5);
+    if (header.channelMode === CHANNEL_MODE_STEREO) {
+        bits.skip(4);
+    }
+    if (header.channelMode >= CHANNEL_MODE_2F2R) {
+        bits.skip(2);
+    }
+    for (let i = 0; i < header.programs; i += 1) {
+        bits.skipIf(8);
+    }
+    if (header.rateCode !== EAC3_REDUCED_RATE_CODE) {
+        bits.skip(1);
+    }
+}
+
+/**
+ * Reports whether an E-AC-3 frame's additional bitstream info sets flag_ec3_extension_type_a (Atmos), walking its header
+ * as FFmpeg's eac3_parse_header does. Null when the packet doesn't start with an independent E-AC-3 frame FFmpeg would read
+ * the flag from (AC-3, a dependent or other substream, or a header that ends early).
+ */
+export function readEAC3Atmos(frame: Uint8Array): boolean | null {
+    try {
+        const bits = new BitReader(frame);
+        const header = readHeaderStart(bits, frame);
+        if (!header) {
+            return null;
+        }
+        skipMixingMetadata(bits, header);
+        skipInformationalMetadata(bits, header);
+        if (header.frameType === EAC3_FRAME_TYPE_INDEPENDENT && header.blocks !== 6) {
+            bits.skip(1); // converter synchronization
+        }
+        if (header.frameType === EAC3_FRAME_TYPE_AC3_CONVERT && (header.blocks === 6 || bits.read(1))) {
+            bits.skip(6); // original frame size code
+        }
+        // Additional bitstream info: the first byte's least significant bit is flag_ec3_extension_type_a
+        if (!bits.read(1)) {
+            return false;
+        }
+        bits.skip(6 + 7);
+        return bits.read(1) === 1;
+    } catch {
+        return null;
+    }
+}
