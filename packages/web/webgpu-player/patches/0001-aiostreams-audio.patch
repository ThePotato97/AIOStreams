+const DM_FLAG_PRESENT: u32 = 1 << 0;
+const DM_FLAG_LEVEL1: u32 = 1 << 1;
+const DM_FLAG_LEVEL3: u32 = 1 << 2;
+const DM_FLAG_LEVEL5: u32 = 1 << 3;
+const DM_FLAG_LEVEL9: u32 = 1 << 4;
+const DM_FLAG_LEVEL254: u32 = 1 << 5;
