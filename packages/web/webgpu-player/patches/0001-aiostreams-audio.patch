diff --git a/src/presentation/dolby-vision-dm/DolbyVisionDM.ts b/src/presentation/dolby-vision-dm/DolbyVisionDM.ts
new file mode 100644
index 0000000..cb6ec2e
--- /dev/null
+++ b/src/presentation/dolby-vision-dm/DolbyVisionDM.ts
@@ -0,0 +1,61 @@
+// The hook for a Dolby Vision display management stage: a build may supply one (implementation.ts), which then takes the
+// tone map's place on the Dolby Vision routes. This file only holds the hook; the stock implementation.ts supplies none,
+// and the routes keep the engine's own tone map.
+import { resolveEngineAssetURL, type EngineAssetPath } from '../../EngineAssets';
+import { loadImplementation } from './implementation';
+
+/** The 'dolby-vision-dm' binding's size in floats, which an implementation's tables fit in. */
+export const DOLBY_VISION_DM_TABLE_FLOAT_CAPACITY = 4_096;
+
+/** The 'dolby-vision-gamut' binding's size in words: a 65-node cube of RGBA uint16, the largest gamut LUT. */
+export const DOLBY_VISION_DM_GAMUT_WORD_CAPACITY = 65 * 65 * 65 * 2;
+
+/** The display the stage renders for. */
+export type DolbyVisionDMTarget = Readonly<{
+    /** HDR output: the canvas takes extended-range values; otherwise SDR. */
+    hdr: boolean
+    /** The display's peak in nits (HDR output's peak setting); SDR uses the DM's own SDR target. */
+    peakNits: number
+}>;
+
+/** What the stage writes for a frame: the 'dolby-vision-dm' binding's floats, and the gamut LUT those were made for. */
+export type DolbyVisionDMFrame = Readonly<{
+    tables: Float32Array<ArrayBuffer>
+    /** The gamut LUT the tables read, null for none; DolbyVisionDMImplementation.loadGamut gives its texels. */
+    gamut: string | null
+    /** The LUT the stage would rather read, when it differs from `gamut` because that one isn't loaded */
+    wantedGamut: string | null
+    /** Shown in the stats, such as "CM v4.0, 1000 nits" */
+    description: string
+}>;
+
+export type DolbyVisionDMImplementation = Readonly<{
+    /**
+     * WGSL defining `fn applyDolbyVisionDM(linearNits: vec3f) -> vec3f`: linear BT.2020 nits of the reconstructed signal to linear BT.2020, relative to SDR white, for
+     * the target, read through the 'dolby-vision-dm' resource (dolbyVisionDM, dolbyVisionGamut).
+     */
+    wgsl: string
+    /** The 'dolby-vision-dm' binding's length in floats. */
+    tableFloatCount: number
+    /**
+     * The tables for a frame's display-management levels (DolbyVisionDisplayManagement.ts, as the parser packs them) and the target,
+     * reading the gamut LUT `loadedGamut` when it is the one wanted; null when the frame carries no display metadata.
+     */
+    compute(block: Uint32Array, target: DolbyVisionDMTarget, loadedGamut: string | null): DolbyVisionDMFrame | null
+    /** A gamut LUT's nodes for the 'dolby-vision-gamut' binding, at most DOLBY_VISION_DM_GAMUT_WORD_CAPACITY words. */
+    loadGamut(name: string): Promise<Uint32Array<ArrayBuffer>>
+}>;
+
+/** Fetches a file of the stage, relative to `<asset base>/dolby-vision-dm/`. */
+export type DolbyVisionDMFetch = (path: string) => Promise<Response>;
+
+const fetchAsset: DolbyVisionDMFetch = (path: string): Promise<Response> =>
+    fetch(resolveEngineAssetURL(`dolby-vision-dm/${path}` as EngineAssetPath));
+
+let loading: Promise<DolbyVisionDMImplementation | null> | null = null;
+
+/** Loads the build's display management stage once; null when the build has none or it fails to load. */
+export function loadDolbyVisionDM(): Promise<DolbyVisionDMImplementation | null> {
+    loading ??= (loadImplementation?.(fetchAsset) ?? Promise.resolve(null)).catch((): null => null);
+    return loading;
+}
